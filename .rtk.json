{
  "tagFormat": "aem-healthcheck-{version}",
  "resources": [
    {
      "path": "pom.xml",
      "type": "xml",
      "params": {
        "property": "project.version"
      }
    },
    {
      "path": "bundle/pom.xml",
      "type": "xml",
      "params": {
        "property": "project.parent.version"
      }
    },
    {
      "path": "content/pom.xml",
      "type": "xml",
      "params": {
        "property": "project.parent.version"
      }
    },
    {
      "path": "CHANGELOG.md",
      "type": "keep-a-changelog"
    }
  ]
}
